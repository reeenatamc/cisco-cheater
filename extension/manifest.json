{
  "manifest_version": 3,
  "name": "Cisco Cheater",
  "version": "2.0.0",
  "description": "Busca respuestas de exámenes de Cisco en examenredes.com",
  "permissions": ["storage", "activeTab", "tabs"],
  "host_permissions": [
    "http://localhost:8000/*",
    "http://127.0.0.1:8000/*",
    "https://examenredes.com/*",
    "https://*.railway.app/*",
    "https://*.feuoir.com/*",
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "commands": {
    "search-answer": {
      "suggested_key": { "default": "Ctrl+Shift+F" },
      "description": "Buscar respuesta de la pregunta actual"
    },
    "capture-screen": {
      "suggested_key": { "default": "Alt+C" },
      "description": "Capturar pantalla y seleccionar área"
    }
  }
}
