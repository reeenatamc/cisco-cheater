{
  "manifest_version": 3,
  "name": "Cisco Cheater",
  "version": "2.0.0",
  "description": "Asistente para exámenes Cisco CCNA",
  "permissions": [
    "activeTab",
    "storage",
    "clipboardWrite",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.netacad.com/*"
      ],
      "js": ["script_front.js"],
      "run_at": "document_idle"
    }
  ],
  "commands": {
    "capture_screen": {
      "suggested_key": {
        "default": "Alt+Period"
      },
      "description": "Capturar pantalla"
    }
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
