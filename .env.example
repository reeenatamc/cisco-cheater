# Copy to .env and fill in (never commit .env):
#   cp .env.example .env

# Required. Generate one: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
# Or: openssl rand -hex 32
SECRET_KEY=

# Local: true | Production: false
DEBUG=true

# Comma-separated hostnames (subdomain wildcards: .railway.app)
ALLOWED_HOSTS=localhost,127.0.0.1,.railway.app,.up.railway.app

# PostgreSQL URL (app uses Postgres-specific search; SQLite is not supported)
# Local example:
DATABASE_URL=postgresql://postgres:TU_PASSWORD@127.0.0.1:5432/cisco_cheater

# Railway managed Postgres often needs SSL; local Postgres usually does not
DATABASE_SSL_REQUIRE=false

# Comma-separated full origins (scheme + host + port)
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Behind Railway/Render HTTPS proxy — set true in production
USE_X_FORWARDED_PROTO=false

# Optional: cookies only over HTTPS (defaults: off when DEBUG=true, on when DEBUG=false)
# CSRF_COOKIE_SECURE=false
# SESSION_COOKIE_SECURE=false
